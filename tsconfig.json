{
	"compilerOptions": {
		"outDir": "./dist",
		"module": "commonjs",
		"target": "ES2022",
		"types": ["node", "jest"],
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"strict": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true
	},
	"include": ["src/**/*", "**/*.test.ts"],
	"exclude": ["node_modules", "dist", "src/**/__tests__"]
}
